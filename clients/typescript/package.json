{
  "name": "@partygamekit/client",
  "version": "0.2.0-preview.2",
  "description": "Communication-neutral browser client for PartyGameKit transports, protocol v2, reconnect and WebRTC DataChannels.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PawelWielga/PartyGameKit.git",
    "directory": "clients/typescript"
  },
  "keywords": [
    "multiplayer",
    "networking",
    "websocket",
    "webrtc",
    "datachannel",
    "lan",
    "reconnect"
  ],
  "dependencies": {
    "@microsoft/signalr": "10.0.11"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
