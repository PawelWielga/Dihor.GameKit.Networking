<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Version>0.2.0-preview.3</Version>
    <Authors>PawelWielga</Authors>
    <Company>PartyGameKit</Company>
    <RepositoryUrl>https://github.com/PawelWielga/PartyGameKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/PawelWielga/PartyGameKit</PackageProjectUrl>
    <PackageTags>multiplayer;communication;networking;lan;signalr;relay;webrtc;datachannel</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>PartyGameKit 0.2.0-preview.3 adds browser-native WebRTC DataChannel communication with optional SignalR signaling while retaining protocol v2 and the communication-only boundary. See CHANGELOG.md.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
